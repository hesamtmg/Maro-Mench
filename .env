# GIMOO backend settings. Copy to backend/.env for local development, or to
# .env in the repo root for `docker compose` (on the server too).

PORT=3000

# Postgres
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=gimoo
DB_SSL=false

# Apply pending migrations when the backend starts (single-instance setups only).
RUN_MIGRATIONS_ON_BOOT=true

# JWT — use long random values in production (openssl rand -hex 32)
JWT_ACCESS_SECRET=change-me-access
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-refresh
JWT_REFRESH_EXPIRES_IN=7d

# Where the frontend runs: CORS origin and links in emails.
# Production: https://gimoo.ir
FRONTEND_URL=http://localhost:5173

# SMTP for password-reset emails
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM="GIMOO <no-reply@gimoo.ir>"

# How long matchmaking waits to fill a room before starting with whoever is queued
MATCHMAKING_FILL_WAIT_MS=15000
